<div metal:use-macro="layout">
  <tal:block metal:fill-slot="head_extra">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  </tal:block>
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>${place['name']} <span class="place-type">${place['type']}</span></h1>
    <p class="place-enclosing" tal:condition="place['enclosing']">
      Part of
      <tal:block tal:repeat="enc place['enclosing']">
        <a href="${base}places/${enc['gramps_id']}/">${enc['name']}</a><tal:block tal:condition="not repeat.enc.end"> &rsaquo; </tal:block>
      </tal:block>
    </p>

    <div id="map" tal:condition="has_map"></div>

    <section tal:condition="events">
      <h2>Events (${format(len(events), ',')})</h2>
      <input type="search" id="people-search" placeholder="Search people…">
      <div id="filters" class="event-filters"></div>
      <table class="events-table" id="places-events-table">
        <thead>
          <tr>
            <th>Year</th>
            <th>Event</th>
            <th>People</th>
            <th tal:condition="place['sub_places']">Place</th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="event events" data-type="${event['type']}">
            <td class="year">${event['year'] or ''}</td>
            <td>
              <a href="${base}events/${event['url_slug']}/">${event['type']}</a>
              <a tal:condition="event['has_photo']" href="${base}events/${event['url_slug']}/" class="photo-icon" title="Has image">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
                </svg>
              </a>
              <a tal:condition="event['grave_url']" href="${event['grave_url']}" class="photo-icon" title="Find a Grave">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14" aria-hidden="true" style="transform: rotate(180deg)">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M9.75 11.625l2.25 2.25m0 0 2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"/>
                </svg>
              </a>
              <span tal:condition="event['is_interesting']" class="tag-icon interesting" title="Interesting">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd"/>
                </svg>
              </span>
              <span tal:condition="event['is_conflict']" class="tag-icon conflict" title="Conflict">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 1.998-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.502-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"/>
                </svg>
              </span>
            </td>
            <td>
              <span tal:condition="event['couple']">
                <span tal:condition="event['couple'][0]"
                      tal:define="person event['couple'][0]">
                  <a href="${base}people/${person['gramps_id']}/"
                     tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
                  <span class="ancestor-badge" tal:condition="person['gramps_id'] in ancestor_ids">ancestor</span>
                  <span class="ancestor-badge descendant" tal:condition="person['gramps_id'] in descendant_ids">descendant</span>
                </span>
                <span tal:condition="event['couple'][0] and event['couple'][1]"> &amp; </span>
                <span tal:condition="event['couple'][1]"
                      tal:define="person event['couple'][1]">
                  <a href="${base}people/${person['gramps_id']}/"
                     tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
                  <span class="ancestor-badge" tal:condition="person['gramps_id'] in ancestor_ids">ancestor</span>
                  <span class="ancestor-badge descendant" tal:condition="person['gramps_id'] in descendant_ids">descendant</span>
                </span>
              </span>
              <span tal:condition="not event['couple']">
                <span tal:repeat="person event['people']">
                  <a href="${base}people/${person['gramps_id']}/"
                     tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
                  <span class="ancestor-badge" tal:condition="person['gramps_id'] in ancestor_ids">ancestor</span>
                  <span class="ancestor-badge descendant" tal:condition="person['gramps_id'] in descendant_ids">descendant</span>
                </span>
              </span>
            </td>
            <td tal:condition="place['sub_places']">
              <a tal:condition="event['sub_place']"
                 href="${base}places/${event['sub_place_id']}/">${event['sub_place']}</a>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <section tal:condition="place['sub_places']">
      <h2>Places within ${place['name']}</h2>
      <ul>
        <li tal:repeat="sub place['sub_places']">
          <a href="${base}places/${sub['gramps_id']}/">${sub['name']}</a>
          <span class="place-type">${sub['type']}</span>
        </li>
      </ul>
    </section>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script tal:condition="has_map"
            src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script tal:condition="has_map">
    var map = L.map('map');
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    var allMarkers = [];

    var subject = ${structure: subject_marker_json};
    if (subject) {
      var sm = L.circleMarker([subject.lat, subject.lon], {
        radius: 9, color: '#b91c1c', fillColor: '#ef4444', fillOpacity: 0.9, weight: 2
      }).bindTooltip(subject.name).addTo(map);
      allMarkers.push(sm);
    }

    var subPlaces = ${structure: sub_place_markers_json};
    subPlaces.forEach(function(p) {
      var m = L.circleMarker([p.lat, p.lon], {
        radius: 7, color: '#1a6ab0', fillColor: '#3388ff', fillOpacity: 0.85, weight: 2
      }).bindTooltip(p.name).addTo(map);
      allMarkers.push(m);
    });

    if (allMarkers.length === 1) {
      map.setView(allMarkers[0].getLatLng(), 11);
    } else {
      map.fitBounds(L.featureGroup(allMarkers).getBounds().pad(0.2));
    }
    </script>
    <script>
    const rows = Array.from(document.querySelectorAll('#places-events-table tbody tr'));
    const filtersEl = document.getElementById('filters');

    const types = [...new Set(rows.map(r => r.dataset.type))];
    rows.forEach(r => { if (r.querySelector('.ancestor-badge')) r.dataset.ancestor = 'true'; });
    const hasAncestors = rows.some(r => r.dataset.ancestor);

    let active = null;
    const peopleSearch = document.getElementById('people-search');

    function applyFilter() {
      const q = peopleSearch.value.toLowerCase();
      rows.forEach(r => {
        const typeMatch = active === null ? true
          : active === 'ancestors' ? r.dataset.ancestor
          : r.dataset.type === active;
        const peopleMatch = r.cells[2].textContent.toLowerCase().includes(q);
        r.hidden = !(typeMatch && peopleMatch);
      });
    }

    peopleSearch.addEventListener('input', applyFilter);

    function makeButton(label, value) {
      const btn = document.createElement('button');
      btn.textContent = label;
      btn.className = 'filter-btn';
      if (value === null) btn.classList.add('active');
      btn.addEventListener('click', () => {
        active = value;
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter();
      });
      return btn;
    }

    if (types.length > 1 || hasAncestors) {
      filtersEl.appendChild(makeButton('All', null));
      types.forEach(t => filtersEl.appendChild(makeButton(t, t)));
      if (hasAncestors) filtersEl.appendChild(makeButton('Ancestors', 'ancestors'));
    }
    </script>
  </tal:block>
</div>
