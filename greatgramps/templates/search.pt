<div metal:use-macro="layout">
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>People</h1>
    <input type="search" id="search" placeholder="Search by name…" autofocus>
    <div id="filters" class="event-filters"></div>
    <p id="count"></p>
    <table id="people-table">
      <thead>
        <tr>
          <th data-col="0" class="sortable sort-asc">Name</th>
          <th data-col="1" class="sortable">Gender</th>
          <th data-col="2" class="sortable">Born</th>
          <th data-col="3" class="sortable">Died</th>
          <th data-col="4" class="sortable">Children</th>
          <th data-col="5" class="sortable">Spouses</th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="row rows"
            tal:attributes="data-ancestor 1 if row['is_ancestor'] else None;
                            data-descendant 1 if row['is_descendant'] else None;
                            data-living 1 if row['is_living'] else None;
                            data-male 1 if row['gender'] == 1 else None;
                            data-female 1 if row['gender'] == 0 else None;
                            data-tags ' '.join(row['tags']) if row.get('tags') else None">
          <td tal:attributes="data-name row['full_name'] + (' ' + ' '.join(row['alt_surnames']) if row['alt_surnames'] else '')">
            <a href="${row['gramps_id']}/"
               tal:attributes="class 'male' if row['gender'] == 1 else ('female' if row['gender'] == 0 else None)">${row['full_name']}</a>
            <span class="ancestor-badge" tal:condition="row['is_ancestor']">ancestor</span>
            <span class="ancestor-badge descendant" tal:condition="row['is_descendant']">descendant</span>
            <span tal:condition="row.get('tags') and 'Interesting' in row['tags']" class="tag-icon interesting" title="Interesting">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd"/>
              </svg>
            </span>
            <span tal:condition="row.get('tags') and 'Conflict' in row['tags']" class="tag-icon conflict" title="Conflict">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 1.998-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.502-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"/>
              </svg>
            </span>
            <span class="alt-surnames" tal:condition="row['alt_surnames']">
              also ${', '.join(row['alt_surnames'])}
            </span>
          </td>
          <td tal:define="label 'Male' if row['gender'] == 1 else ('Female' if row['gender'] == 0 else '')"
              tal:attributes="data-val label"
              tal:content="label"></td>
          <td data-val="${row['birth_year'] or ''}">${row['birth_year'] or ''}</td>
          <td data-val="${row['death_year'] or ''}">${row['death_year'] or ''}</td>
          <td data-val="${row['num_children']}">${format(row['num_children'], ',')}</td>
          <td data-val="${row['num_spouses']}">${format(row['num_spouses'], ',')}</td>
        </tr>
      </tbody>
    </table>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script>
    const tbody = document.querySelector('#people-table tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const countEl = document.getElementById('count');
    const total = rows.length;

    function updateCount(visible) {
      countEl.textContent = visible === total ? `$${total.toLocaleString()} people` : `$${visible.toLocaleString()} of $${total.toLocaleString()} people`;
    }
    updateCount(total);

    let ancestorsOnly = false;
    let descendantsOnly = false;
    let livingOnly = false;
    let maleOnly = false;
    let femaleOnly = false;
    const activeTags = new Set();

    function applyFilters() {
      const words = document.getElementById('search').value.toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      rows.forEach(row => {
        const name = (row.cells[0].dataset.name || row.cells[0].textContent).toLowerCase();
        const rowTags = row.dataset.tags ? row.dataset.tags.split(' ') : [];
        const tagMatch = activeTags.size === 0 || [...activeTags].every(t => rowTags.includes(t));
        const show = words.every(w => name.includes(w))
          && (!ancestorsOnly || row.dataset.ancestor)
          && (!descendantsOnly || row.dataset.descendant)
          && (!livingOnly || row.dataset.living)
          && (!maleOnly || row.dataset.male)
          && (!femaleOnly || row.dataset.female)
          && tagMatch;
        row.hidden = !show;
        if (show) visible++;
      });
      updateCount(visible);
    }

    document.getElementById('search').addEventListener('input', applyFilters);

    const hasAncestors = rows.some(r => r.dataset.ancestor);
    const hasDescendants = rows.some(r => r.dataset.descendant);
    const hasLiving = rows.some(r => r.dataset.living);
    const hasMale = rows.some(r => r.dataset.male);
    const hasFemale = rows.some(r => r.dataset.female);

    function makeToggle(label, activate) {
      const btn = document.createElement('button');
      btn.textContent = label;
      btn.className = 'filter-btn toggle-btn';
      btn.addEventListener('click', () => {
        activate(btn);
        applyFilters();
      });
      return btn;
    }

    const filtersEl = document.getElementById('filters');
    const ancestorBtn = hasAncestors ? makeToggle('Ancestors', btn => {
      ancestorsOnly = !ancestorsOnly;
      if (ancestorsOnly) { descendantsOnly = false; descendantBtn && descendantBtn.classList.remove('active'); }
      btn.classList.toggle('active', ancestorsOnly);
    }) : null;
    const descendantBtn = hasDescendants ? makeToggle('Descendants', btn => {
      descendantsOnly = !descendantsOnly;
      if (descendantsOnly) { ancestorsOnly = false; ancestorBtn && ancestorBtn.classList.remove('active'); }
      btn.classList.toggle('active', descendantsOnly);
    }) : null;
    if (ancestorBtn) filtersEl.appendChild(ancestorBtn);
    if (descendantBtn) filtersEl.appendChild(descendantBtn);
    if (hasLiving) filtersEl.appendChild(makeToggle('Living', btn => {
      livingOnly = !livingOnly;
      btn.classList.toggle('active', livingOnly);
    }));
    const maleBtn = hasMale ? makeToggle('Male', btn => {
      maleOnly = !maleOnly;
      if (maleOnly) { femaleOnly = false; femaleBtn && femaleBtn.classList.remove('active'); }
      btn.classList.toggle('active', maleOnly);
    }) : null;
    const femaleBtn = hasFemale ? makeToggle('Female', btn => {
      femaleOnly = !femaleOnly;
      if (femaleOnly) { maleOnly = false; maleBtn && maleBtn.classList.remove('active'); }
      btn.classList.toggle('active', femaleOnly);
    }) : null;
    if (maleBtn) filtersEl.appendChild(maleBtn);
    if (femaleBtn) filtersEl.appendChild(femaleBtn);

    const allTags = [...new Set(rows.flatMap(r => r.dataset.tags ? r.dataset.tags.split(' ') : []))].sort();
    if (allTags.length) {
      filtersEl.appendChild(document.createElement('span'));
      allTags.forEach(tag => {
        const btn = document.createElement('button');
        btn.textContent = tag;
        btn.className = 'filter-btn toggle-btn';
        btn.addEventListener('click', () => {
          if (activeTags.has(tag)) { activeTags.delete(tag); } else { activeTags.add(tag); }
          btn.classList.toggle('active', activeTags.has(tag));
          applyFilters();
        });
        filtersEl.appendChild(btn);
      });
    }

    // Sort
    let sortCol = null, sortAsc = true;
    document.querySelectorAll('#people-table th').forEach(th => {
      th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        const col = parseInt(th.dataset.col);
        sortAsc = sortCol === col ? !sortAsc : true;
        sortCol = col;

        document.querySelectorAll('#people-table th').forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
        th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');

        rows.sort((a, b) => {
          const aCell = a.cells[col];
          const bCell = b.cells[col];
          const aVal = aCell.dataset.val !== undefined ? aCell.dataset.val : aCell.textContent;
          const bVal = bCell.dataset.val !== undefined ? bCell.dataset.val : bCell.textContent;
          const aNum = parseFloat(aVal), bNum = parseFloat(bVal);
          let cmp;
          if (!isNaN(aNum) && !isNaN(bNum)) {
            cmp = aNum - bNum;
          } else {
            cmp = aVal.localeCompare(bVal);
          }
          return sortAsc ? cmp : -cmp;
        });
        rows.forEach(r => tbody.appendChild(r));
      });
    });
    </script>
  </tal:block>
</div>
