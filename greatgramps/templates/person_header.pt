<div metal:define-macro="person_header" class="person-header" tal:define="
  birth_year person['birth_year'];
  death_year person['death_year'];
  is_living person['is_living'];
  living_age max(0, current_year - birth_year - 1) if birth_year else None;
  died_age death_year - birth_year if birth_year and death_year else None;
">
  <div class="person-header-info">
    <h1>
      <tal:block tal:condition="not surname_url">${person['full_name']}</tal:block>
      <tal:block tal:condition="surname_url and (person['given'] or person['surname'])">
        <span tal:condition="person['given']">${person['given']} </span><a href="${surname_url}">${person['surname']}</a>
      </tal:block>
      <tal:block tal:condition="surname_url and not person['given'] and not person['surname']">[Unknown]</tal:block>
      <small class="years" tal:condition="is_living and birth_year">(${birth_year}–)</small>
      <small class="years" tal:condition="not is_living and (birth_year or death_year)">(${birth_year or '?'}–${death_year or ''})</small>
      <span class="ancestor-badge private" tal:condition="person['is_private']">private</span>
    </h1>
    <p class="person-alt-names" tal:condition="person['alt_names']">
      <tal:block tal:repeat="n person['alt_names']">
        <tal:block tal:condition="not repeat.n.start">, </tal:block>
        <tal:block tal:define="url alt_surname_urls.get(n['surname'])">
          <a tal:condition="url" href="${url}">${n['full_name'] or n['surname']}</a>
          <span tal:condition="not url">${n['full_name'] or n['surname']}</span>
        </tal:block>
        <span class="years">(${n['type'].lower()})</span>
      </tal:block>
    </p>
    <table class="person-meta-table" tal:condition="not is_me or (is_living and living_age) or (not is_living and died_age)">
      <tr tal:condition="not is_me">
        <td>
          <span class="ancestor-badge" tal:condition="is_ancestor">ancestor</span>
          <span class="ancestor-badge descendant" tal:condition="is_descendant">descendant</span>
          <span class="ancestor-badge relative" tal:condition="relation and not is_ancestor and not is_descendant">relative</span>
          <span class="ancestor-badge by-marriage" tal:condition="by_marriage">related by marriage</span>
          <span class="ancestor-badge unrelated" tal:condition="not relation and not by_marriage and not is_descendant">unrelated</span>
        </td>
        <td tal:condition="relation">your ${relation}</td>
        <td tal:condition="by_marriage and marriage_relation">your ${marriage_relation}</td>
        <td tal:condition="not relation and not (by_marriage and marriage_relation)"></td>
      </tr>
      <tr tal:condition="is_living and living_age">
        <td><span class="ancestor-badge living">living</span></td>
        <td>Age ${living_age}</td>
      </tr>
      <tr tal:condition="not is_living and died_age">
        <td><span class="ancestor-badge deceased">deceased</span></td>
        <td>died in ${death_year} aged ${died_age}</td>
      </tr>
    </table>
  </div>
  <div class="person-header-photo">
    <tal:block tal:condition="photos">
      <a href="${photos[0]['url']}">
        <img src="${photos[0]['url']}" alt="${photos[0]['description']}" class="person-photo">
      </a>
    </tal:block>
  </div>
</div>
