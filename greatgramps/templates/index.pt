<div metal:use-macro="layout">
  <tal:block metal:fill-slot="head_extra" tal:condition="index_map_json != '[]'">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  </tal:block>
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>${root_full_name}${"'" if root_full_name[-1].lower() == 's' else "'s"} family tree</h1>

    <div class="summary-stats">
      <div class="stat">
        <span class="stat-value">${format(summary['total_people'], ',')}</span>
        <span class="stat-label">people</span>
      </div>
      <div class="stat">
        <span class="stat-value">${format(summary['total_ancestors'], ',')}</span>
        <span class="stat-label">ancestors</span>
      </div>
      <div class="stat" tal:condition="summary['total_descendants']">
        <span class="stat-value">${format(summary['total_descendants'], ',')}</span>
        <span class="stat-label">descendants</span>
      </div>
      <div class="stat">
        <span class="stat-value">${format(summary['total_events'], ',')}</span>
        <span class="stat-label">events</span>
      </div>
      <div class="stat">
        <span class="stat-value">${format(summary['total_places'], ',')}</span>
        <span class="stat-label">places</span>
      </div>
      <div class="stat" tal:condition="summary['year_from']">
        <span class="stat-value">${summary['year_from']}–${summary['year_to']}</span>
        <span class="stat-label">records</span>
      </div>
    </div>

    <div class="summary-grid">
      <section>
        <h2>Top surnames</h2>
        <table class="summary-table">
          <tr tal:repeat="item summary['top_surnames']">
            <td><a href="surnames/${item[2]}/">${item[0]}</a></td>
            <td class="year">${format(item[1], ',')}</td>
          </tr>
        </table>
      </section>

      <section>
        <h2>Top male names</h2>
        <table class="summary-table">
          <tr tal:repeat="item summary['top_male_given']">
            <td class="male">${item[0]}</td>
            <td class="year">${format(item[1], ',')}</td>
          </tr>
        </table>
      </section>

      <section>
        <h2>Top female names</h2>
        <table class="summary-table">
          <tr tal:repeat="item summary['top_female_given']">
            <td class="female">${item[0]}</td>
            <td class="year">${format(item[1], ',')}</td>
          </tr>
        </table>
      </section>

      <section class="full-width">
        <h2>Ancestors</h2>
        <table class="summary-table">
          <tr tal:repeat="gen_group summary['generations']">
            <td>
              <span tal:condition="gen_group['gen'] == 0">
                <a href="people/${me_id}/">Me</a>
              </span>
              <span tal:condition="gen_group['gen'] == 1">Parents</span>
              <span tal:condition="gen_group['gen'] == 2">Grandparents</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandparents</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandparents</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 2}th great-grandparents</span>
            </td>
            <td class="year" tal:condition="gen_group['gen'] == 0">1</td>
            <td class="year" tal:condition="gen_group['gen'] != 0">
              ${format(len(gen_group['people']), ',')} / ${format(2 ** gen_group['gen'], ',')}
            </td>
            <td tal:condition="gen_group['gen'] == 0"></td>
            <td class="pct-col" tal:condition="gen_group['gen'] != 0"
                tal:define="pct len(gen_group['people']) * 100 // (2 ** gen_group['gen']);
                            bar_pct round(len(gen_group['people']) * 100 / (2 ** gen_group['gen']), 1);
                            pct_class 'pct-high' if pct >= 75 else ('pct-mid' if pct >= 50 else 'pct-low')">
              <span class="pct-text">${pct}%</span>
              <div class="pct-bar">
                <div tal:attributes="class 'pct-bar-fill ' + pct_class; style 'width:' + str(bar_pct) + '%'"></div>
              </div>
            </td>
          </tr>
        </table>
      </section>

      <section class="full-width" tal:condition="summary['descendant_generations']">
        <h2>Descendants</h2>
        <table class="summary-table">
          <tr tal:repeat="gen_group summary['descendant_generations']">
            <td>
              <span tal:condition="gen_group['gen'] == 1">Children</span>
              <span tal:condition="gen_group['gen'] == 2">Grandchildren</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandchildren</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandchildren</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 2}th great-grandchildren</span>
            </td>
            <td class="year">${format(len(gen_group['people']), ',')}</td>
          </tr>
        </table>
      </section>

      <section class="full-width" tal:condition="pdf_links">
        <h2>PDF charts</h2>
        <ul class="pdf-links">
          <li tal:repeat="pdf pdf_links">
            <a href="${pdf['filename']}">${pdf['label']}</a>
          </li>
        </ul>
      </section>

      <section class="full-width" tal:condition="index_map_json != '[]'">
        <h2>Map</h2>
        <div class="event-filters">
          <button class="filter-btn active" id="map-ancestors">Ancestors</button>
          <button class="filter-btn active" id="map-descendants" tal:condition="summary['total_descendants']">Descendants</button>
          <button class="filter-btn" id="map-births">Births</button>
        </div>
        <div id="index-map"></div>
      </section>
    </div>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script tal:condition="index_map_json != '[]'"
            src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script tal:condition="index_map_json != '[]'">
    var points = ${structure: index_map_json};
    var map = L.map('index-map');
    var bounds = points.map(function(p) { return [parseFloat(p.lat), parseFloat(p.lon)]; });
    map.fitBounds(bounds, {padding: [20, 20], maxZoom: 8});
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
    var markers = points.map(function(p) {
      var marker = L.circleMarker([parseFloat(p.lat), parseFloat(p.lon)], {
        radius: Math.max(4, Math.min(14, 3 + p.people.length * 2)),
        color: '#5a3e28',
        fillColor: '#5a3e28',
        fillOpacity: 0.6,
        weight: 1,
      }).bindPopup(function() {
        var showAnc = ancBtn.classList.contains('active');
        var showDesc = descBtn && descBtn.classList.contains('active');
        var birthsOnly = birthBtn.classList.contains('active');
        var people = p.people.filter(function(person) {
          var personMatch = (showAnc && person.is_ancestor) || (showDesc && person.is_descendant);
          var typeMatch = !birthsOnly || person.types.indexOf('Birth') !== -1;
          return personMatch && typeMatch;
        });
        var peopleHtml = people.map(function(person) {
          var types = birthsOnly ? ['Birth'] : person.types;
          return '<a href="' + person.url + '">' + person.name + '</a>: ' + types.join(', ');
        }).join('<br>');
        return '<strong><a href="' + p.url + '">' + p.name + '</a></strong><br>' + peopleHtml;
      });
      marker._data = p;
      return marker;
    });
    var markerLayer = L.layerGroup(markers).addTo(map);
    var ancBtn = document.getElementById('map-ancestors');
    var descBtn = document.getElementById('map-descendants');
    var birthBtn = document.getElementById('map-births');
    function applyFilter() {
      var showAnc = ancBtn.classList.contains('active');
      var showDesc = descBtn && descBtn.classList.contains('active');
      var birthsOnly = birthBtn.classList.contains('active');
      markers.forEach(function(marker) {
        var d = marker._data;
        var personMatch = (showAnc && d.has_ancestor) || (showDesc && d.has_descendant);
        var typeMatch = !birthsOnly || d.people.some(function(p) { return p.types.indexOf('Birth') !== -1; });
        if (personMatch && typeMatch) {
          markerLayer.addLayer(marker);
        } else {
          markerLayer.removeLayer(marker);
        }
      });
    }
    ancBtn.addEventListener('click', function() { ancBtn.classList.toggle('active'); applyFilter(); });
    if (descBtn) descBtn.addEventListener('click', function() { descBtn.classList.toggle('active'); applyFilter(); });
    birthBtn.addEventListener('click', function() { birthBtn.classList.toggle('active'); applyFilter(); });
    </script>
  </tal:block>
</div>
