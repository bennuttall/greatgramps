<div metal:use-macro="layout">
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>${root_full_name}${"'" if root_full_name[-1].lower() == 's' else "'s"} family tree</h1>

    <div class="summary-stats">
      <div class="stat">
        <span class="stat-value">${format(summary['total_people'], ',')}</span>
        <span class="stat-label">people</span>
      </div>
      <div class="stat">
        <span class="stat-value">${format(summary['total_ancestors'], ',')}</span>
        <span class="stat-label">ancestors</span>
      </div>
      <div class="stat" tal:condition="summary['total_descendants']">
        <span class="stat-value">${format(summary['total_descendants'], ',')}</span>
        <span class="stat-label">descendants</span>
      </div>
      <div class="stat">
        <span class="stat-value">${format(summary['total_events'], ',')}</span>
        <span class="stat-label">events</span>
      </div>
      <div class="stat">
        <span class="stat-value">${format(summary['total_places'], ',')}</span>
        <span class="stat-label">places</span>
      </div>
      <div class="stat" tal:condition="summary['year_from']">
        <span class="stat-value">${summary['year_from']}–${summary['year_to']}</span>
        <span class="stat-label">records</span>
      </div>
    </div>

    <div class="summary-grid">
      <section>
        <h2>Top surnames</h2>
        <table class="summary-table">
          <tr tal:repeat="item summary['top_surnames']">
            <td><a href="surnames/${item[2]}/">${item[0]}</a></td>
            <td class="year">${format(item[1], ',')}</td>
          </tr>
        </table>
      </section>

      <section>
        <h2>Top male names</h2>
        <table class="summary-table">
          <tr tal:repeat="item summary['top_male_given']">
            <td class="male">${item[0]}</td>
            <td class="year">${format(item[1], ',')}</td>
          </tr>
        </table>
      </section>

      <section>
        <h2>Top female names</h2>
        <table class="summary-table">
          <tr tal:repeat="item summary['top_female_given']">
            <td class="female">${item[0]}</td>
            <td class="year">${format(item[1], ',')}</td>
          </tr>
        </table>
      </section>

      <section class="full-width">
        <h2>Ancestors</h2>
        <table class="summary-table">
          <tr tal:repeat="gen_group summary['generations']">
            <td>
              <span tal:condition="gen_group['gen'] == 0">
                <a href="people/${me_id}/">Me</a>
              </span>
              <span tal:condition="gen_group['gen'] == 1">Parents</span>
              <span tal:condition="gen_group['gen'] == 2">Grandparents</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandparents</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandparents</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 2}th great-grandparents</span>
            </td>
            <td class="year" tal:condition="gen_group['gen'] == 0">1</td>
            <td class="year" tal:condition="gen_group['gen'] != 0">
              ${format(len(gen_group['people']), ',')} / ${format(2 ** gen_group['gen'], ',')}
            </td>
            <td tal:condition="gen_group['gen'] == 0"></td>
            <td class="pct-col" tal:condition="gen_group['gen'] != 0"
                tal:define="pct len(gen_group['people']) * 100 // (2 ** gen_group['gen']);
                            bar_pct round(len(gen_group['people']) * 100 / (2 ** gen_group['gen']), 1);
                            pct_class 'pct-high' if pct >= 75 else ('pct-mid' if pct >= 50 else 'pct-low')">
              <span class="pct-text">${pct}%</span>
              <div class="pct-bar">
                <div tal:attributes="class 'pct-bar-fill ' + pct_class; style 'width:' + str(bar_pct) + '%'"></div>
              </div>
            </td>
          </tr>
        </table>
      </section>

      <section class="full-width" tal:condition="summary['descendant_generations']">
        <h2>Descendants</h2>
        <table class="summary-table">
          <tr tal:repeat="gen_group summary['descendant_generations']">
            <td>
              <span tal:condition="gen_group['gen'] == 1">Children</span>
              <span tal:condition="gen_group['gen'] == 2">Grandchildren</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandchildren</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandchildren</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 2}th great-grandchildren</span>
            </td>
            <td class="year">${format(len(gen_group['people']), ',')}</td>
          </tr>
        </table>
      </section>
    </div>
  </div>
</div>
