<div metal:use-macro="layout">
  <tal:block metal:fill-slot="head_extra" tal:condition="event_map_json != '[]'">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  </tal:block>
  <div metal:fill-slot="content" tal:omit-tag="1">

    <h1>
      ${event['description']}
      <span tal:condition="event['is_interesting']" class="tag-icon interesting" title="Interesting">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd"/>
        </svg>
      </span>
      <span tal:condition="event['is_conflict']" class="tag-icon conflict" title="Conflict">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 1.998-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.502-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"/>
        </svg>
      </span>
    </h1>

    <div class="photos" tal:condition="photos">
      <a tal:repeat="photo photos" href="${photo['url']}">
        <img src="${photo['url']}"
             alt="${photo['description']}"
             class="person-photo">
      </a>
    </div>

    <table class="events">
      <tr tal:condition="event['date']">
        <th>Date</th>
        <td>${event['date']}</td>
      </tr>
      <tr tal:condition="event['place']">
        <th>Place</th>
        <td>
          <a tal:condition="event['place_id']" href="${base}places/${event['place_id']}/">${event['place']}</a>
          <span tal:condition="not event['place_id']">${event['place']}</span>
        </td>
      </tr>
    </table>

    <div id="map" tal:condition="event_map_json != '[]'"></div>

    <tal:block tal:condition="event['notes']">
      <h2>Notes</h2>
      <pre class="event-note" tal:repeat="note event['notes']">${note}</pre>
    </tal:block>

    <tal:block tal:condition="event['people']">
      <h2>People</h2>
      <table class="events-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Born</th>
            <th>Age</th>
            <th>Relation</th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="person event['people']">
            <td>
              <a href="${base}people/${person['gramps_id']}/"
                 tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
              <span class="ancestor-badge" tal:condition="person['gramps_id'] in ancestor_ids">ancestor</span>
              <span class="ancestor-badge descendant" tal:condition="person['gramps_id'] in descendant_ids">descendant</span>
            </td>
            <td class="year">${person['birth_year'] or ''}</td>
            <td class="year" tal:condition="event['year'] and person['birth_year']">${max(0, event['year'] - person['birth_year'] - 1)}</td>
            <td class="year" tal:condition="not (event['year'] and person['birth_year'])"></td>
            <td class="year" tal:define="rel relation_map.get(person['gramps_id'])">${('your ' + rel) if rel else ''}</td>
          </tr>
        </tbody>
      </table>
    </tal:block>

  </div>
  <tal:block metal:fill-slot="scripts">
    <script tal:condition="event_map_json != '[]'"
            src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script tal:condition="event_map_json != '[]'">
    var points = ${structure: event_map_json};
    var map = L.map('map');
    var bounds = points.map(p => [p.lat, p.lon]);
    map.fitBounds(bounds, {padding: [20, 20], maxZoom: 10});
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
    points.forEach(function(p) {
      L.marker([p.lat, p.lon]).addTo(map)
        .bindPopup('<a href="' + p.url + '">' + p.name + '</a>');
    });
    </script>
  </tal:block>
</div>
