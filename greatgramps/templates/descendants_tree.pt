<div metal:use-macro="layout">
  <tal:block metal:fill-slot="head_extra" tal:condition="descendants_map_json != '[]'">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  </tal:block>
  <div metal:fill-slot="content" tal:omit-tag="1">
    <tal:block metal:use-macro="person_header"></tal:block>
    <nav class="person-tabs">
      <a href="${base}people/${person['gramps_id']}/">Profile</a>
      <a href="${base}people/${person['gramps_id']}/ancestors/">Ancestors <span class="tab-count">(${format(num_ancestors, ',')})</span></a>
      <span class="active">Descendants <span class="tab-count">(${format(num_descendants, ',')})</span></span>
      <a tal:condition="num_pictures" href="${base}people/${person['gramps_id']}/pictures/">Pictures <span class="tab-count">(${format(num_pictures, ',')})</span></a>
      <a tal:condition="num_more" href="${base}people/${person['gramps_id']}/more/">More</a>
      <a tal:condition="'explore' not in excluded_pages" href="${base}explore/#focus=${person['gramps_id']}" class="tab-explore">Explore</a>
    </nav>
    <div class="pedigree-wrap">
      <div class="pedigree-chart" tal:attributes="style tree_grid_style">
        <a tal:repeat="node nodes"
           tal:attributes="
             href base + 'people/' + person['gramps_id'] + '/' if node['gen'] == 0 else base + 'people/' + node['gramps_id'] + '/descendants/';
             class 'pedigree-cell gen-' + str(node['gen']) + (' has-further-down' if node['has_further'] else '') + (' male' if node['gender'] == 1 else (' female' if node['gender'] == 0 else ''));
             style node['grid_style']
           ">
          <span class="pedigree-name">${node['full_name']}</span>
          <span class="pedigree-years" tal:condition="node['birth_year'] or node['death_year']">
            ${node['birth_year'] or '?'}–${node['death_year'] or ''}
          </span>
          <span class="pedigree-children" tal:condition="node['num_children']">
            ${format(node['num_children'], ',')} child${'' if node['num_children'] == 1 else 'ren'}
          </span>
        </a>
      </div>
    </div>
    <div id="map" tal:condition="descendants_map_json != '[]'"></div>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script tal:condition="descendants_map_json != '[]'"
            src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script tal:condition="descendants_map_json != '[]'">
    var points = ${structure: descendants_map_json};
    var map = L.map('map');
    var bounds = points.map(p => [parseFloat(p.lat), parseFloat(p.lon)]);
    map.fitBounds(bounds, {padding: [20, 20], maxZoom: 10});
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
    points.forEach(function(p) {
      var peopleHtml = p.people.map(function(person) {
        return '<a href="' + person.url + '">' + person.name + '</a>: ' + person.types.join(', ');
      }).join('<br>');
      L.circleMarker([parseFloat(p.lat), parseFloat(p.lon)], {
        radius: Math.max(4, Math.min(14, 3 + p.people.length * 2)),
        color: '#5a3e28',
        fillColor: '#5a3e28',
        fillOpacity: 0.6,
        weight: 1,
      }).addTo(map)
        .bindPopup('<strong><a href="' + p.url + '">' + p.name + '</a></strong><br>' + peopleHtml);
    });
    </script>
  </tal:block>
</div>
