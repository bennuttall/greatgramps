<div metal:use-macro="layout">
  <tal:block metal:fill-slot="head_extra">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  </tal:block>
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>Cemeteries</h1>

    <div id="map"></div>

    <input type="search" id="search" placeholder="Search cemeteries…">
    <div id="filters" class="event-filters"></div>
    <p id="count"></p>
    <table id="cemeteries-table" class="events-table">
      <thead>
        <tr>
          <th data-col="0" class="sortable sort-asc">Cemetery</th>
          <th data-col="1" class="sortable">Place</th>
          <th data-col="2" class="sortable">Burials</th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="cemetery cemeteries">
          <td><a href="${base}places/${cemetery['gramps_id']}/">${cemetery['name']}</a></td>
          <td>${', '.join(p['name'] for p in cemetery['enclosing'])}</td>
          <td class="year"
              data-val="${cemetery['burial_count']}"
              data-total="${cemetery['burial_count']}"
              data-ancestor="${cemetery['ancestor_burial_count']}">${cemetery['burial_count']}</td>
        </tr>
      </tbody>
    </table>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    var map = L.map('map').setView([53.5, -1.5], 6);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    var places = ${structure: mappable_json};

    var markers = places.map(function(p) {
      var marker = L.circleMarker([p.lat, p.lon], {
        radius: Math.max(4, Math.min(14, 3 + p.count / 2)),
        color: '#5a3e28',
        fillColor: '#5a3e28',
        fillOpacity: 0.6,
        weight: 1,
      }).addTo(map);
      marker.bindPopup('<a href="' + p.url + '">' + p.name + '</a> (' + p.count + ' burials)');
      return {marker: marker, p: p};
    });

    function updateMap() {
      markers.forEach(function(m) {
        var count = ancestorsOnly ? m.p.ancestor_count : m.p.count;
        if (count > 0) {
          m.marker.setRadius(Math.max(4, Math.min(14, 3 + count / 2)));
          m.marker.setPopupContent('<a href="' + m.p.url + '">' + m.p.name + '</a> (' + count + ' burials)');
          if (!map.hasLayer(m.marker)) m.marker.addTo(map);
        } else {
          if (map.hasLayer(m.marker)) m.marker.remove();
        }
      });
    }
    </script>
    <script>
    const tbody = document.querySelector('#cemeteries-table tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const countEl = document.getElementById('count');
    const total = rows.length;

    function updateCount(visible) {
      countEl.textContent = visible === total ? `$${total.toLocaleString()} cemeteries` : `$${visible.toLocaleString()} of $${total.toLocaleString()} cemeteries`;
    }

    let ancestorsOnly = false;

    function applyFilters() {
      const q = document.getElementById('search').value.toLowerCase();
      let visible = 0;
      rows.forEach(row => {
        const nameMatch = [0, 1].some(i => row.cells[i].textContent.toLowerCase().includes(q));
        const burialsCell = row.cells[2];
        const ancestorCount = parseInt(burialsCell.dataset.ancestor);
        const show = nameMatch && (!ancestorsOnly || ancestorCount > 0);
        row.hidden = !show;
        if (show) visible++;
        const count = ancestorsOnly ? ancestorCount : parseInt(burialsCell.dataset.total);
        burialsCell.textContent = count;
        burialsCell.dataset.val = count;
      });
      updateCount(visible);
      updateMap();
    }
    updateCount(total);

    document.getElementById('search').addEventListener('input', applyFilters);

    const hasAncestors = rows.some(r => parseInt(r.cells[2].dataset.ancestor) > 0);
    if (hasAncestors) {
      const filtersEl = document.getElementById('filters');
      function makeCemBtn(label, value) {
        const btn = document.createElement('button');
        btn.textContent = label;
        btn.className = 'filter-btn' + (value ? '' : ' active');
        btn.addEventListener('click', () => {
          ancestorsOnly = value;
          filtersEl.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          applyFilters();
        });
        return btn;
      }
      filtersEl.appendChild(makeCemBtn('All', false));
      filtersEl.appendChild(makeCemBtn('Ancestors', true));
    }

    let sortCol = null, sortAsc = true;
    document.querySelectorAll('#cemeteries-table th').forEach(th => {
      th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        const col = parseInt(th.dataset.col);
        sortAsc = sortCol === col ? !sortAsc : true;
        sortCol = col;
        document.querySelectorAll('#cemeteries-table th').forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
        th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');
        rows.sort((a, b) => {
          const aCell = a.cells[col], bCell = b.cells[col];
          const aVal = aCell.dataset.val ?? aCell.textContent;
          const bVal = bCell.dataset.val ?? bCell.textContent;
          const aNum = parseFloat(aVal), bNum = parseFloat(bVal);
          const cmp = (!isNaN(aNum) && !isNaN(bNum)) ? aNum - bNum : aVal.localeCompare(bVal);
          return sortAsc ? cmp : -cmp;
        });
        rows.forEach(r => tbody.appendChild(r));
      });
    });
    </script>
  </tal:block>
</div>
