<div metal:use-macro="layout">
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>Census Records</h1>

    <div tal:repeat="gen gen_list">
      <h2>${gen['label']} <span class="tab-count">(${len(gen['people'])})</span></h2>
      <div class="census-records-scroll">
        <table class="events-table census-records-table">
          <thead>
            <tr>
              <th>Name</th>
              <th tal:repeat="year census_years">${year}</th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="person gen['people']">
              <td>
                <a href="/people/${person['gramps_id']}/"
                   tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)"
                >${person['full_name']}</a>
                <span class="years" tal:condition="person['birth_year'] or person['death_year']">(${person['birth_year'] or ''}–${person['death_year'] or ''})</span>
                <a tal:condition="person['ancestry_url']" tal:attributes="href person['ancestry_url']" class="ancestor-badge ancestry">A</a>
              </td>
              <tal:block tal:repeat="year census_years">
                <td tal:define="s person['census'][year]"
                    tal:attributes="class 'record-check has-record' if s['type'] == 'found' else ('record-check missing-record' if s['type'] == 'missing' else 'record-check record-na');
                                    title 'Not yet born' if s['type'] == 'unborn' else ('Deceased' if s['type'] == 'deceased' else None)"
                >
                  <strong tal:condition="s['type'] == 'found' and not s.get('duplicate')">${s['count']}</strong>
                  <span tal:condition="s.get('duplicate')" title="Multiple records for this year" class="duplicate-warning">⚠</span>
                  <span tal:condition="s['type'] == 'missing'" class="census-missing">✗</span>
                  <span tal:condition="s['type'] == 'unborn'" class="census-unborn">○</span>
                  <span tal:condition="s['type'] == 'deceased'" class="census-deceased">†</span>
                </td>
              </tal:block>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
