<div metal:use-macro="layout">
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>People</h1>
    <input type="search" id="search" placeholder="Search by name…" autofocus>
    <label><input type="checkbox" id="ancestors-only"> Ancestors only</label>
    <p id="count"></p>
    <table id="people-table">
      <thead>
        <tr>
          <th data-col="0" class="sortable sort-asc">Name</th>
          <th data-col="1" class="sortable">Gender</th>
          <th data-col="2" class="sortable">Born</th>
          <th data-col="3" class="sortable">Died</th>
          <th data-col="4" class="sortable">Children</th>
          <th data-col="5" class="sortable">Spouses</th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="row rows" tal:attributes="data-ancestor 1 if row['is_ancestor'] else None">
          <td tal:attributes="data-name row['full_name'] + (' ' + ' '.join(row['alt_surnames']) if row['alt_surnames'] else '')">
            <a href="${row['gramps_id']}/"
               tal:attributes="class 'male' if row['gender'] == 1 else ('female' if row['gender'] == 0 else None)">${row['full_name']}</a>
            <span class="ancestor-badge" tal:condition="row['is_ancestor']">ancestor</span>
            <span class="alt-surnames" tal:condition="row['alt_surnames']">
              also ${', '.join(row['alt_surnames'])}
            </span>
          </td>
          <td tal:define="label 'Male' if row['gender'] == 1 else ('Female' if row['gender'] == 0 else '')"
              tal:attributes="data-val label"
              tal:content="label"></td>
          <td data-val="${row['birth_year'] or ''}">${row['birth_year'] or ''}</td>
          <td data-val="${row['death_year'] or ''}">${row['death_year'] or ''}</td>
          <td data-val="${row['num_children']}">${format(row['num_children'], ',')}</td>
          <td data-val="${row['num_spouses']}">${format(row['num_spouses'], ',')}</td>
        </tr>
      </tbody>
    </table>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script>
    const tbody = document.querySelector('#people-table tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const countEl = document.getElementById('count');
    const total = rows.length;

    function updateCount(visible) {
      countEl.textContent = visible === total ? `$${total.toLocaleString()} people` : `$${visible.toLocaleString()} of $${total.toLocaleString()} people`;
    }
    updateCount(total);

    function applyFilters() {
      const words = document.getElementById('search').value.toLowerCase().split(/\s+/).filter(Boolean);
      const ancestorsOnly = document.getElementById('ancestors-only').checked;
      let visible = 0;
      rows.forEach(row => {
        const name = (row.cells[0].dataset.name || row.cells[0].textContent).toLowerCase();
        const show = words.every(w => name.includes(w)) && (!ancestorsOnly || row.dataset.ancestor);
        row.hidden = !show;
        if (show) visible++;
      });
      updateCount(visible);
    }

    document.getElementById('search').addEventListener('input', applyFilters);
    document.getElementById('ancestors-only').addEventListener('change', applyFilters);

    // Sort
    let sortCol = null, sortAsc = true;
    document.querySelectorAll('#people-table th').forEach(th => {
      th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        const col = parseInt(th.dataset.col);
        sortAsc = sortCol === col ? !sortAsc : true;
        sortCol = col;

        document.querySelectorAll('#people-table th').forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
        th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');

        rows.sort((a, b) => {
          const aCell = a.cells[col];
          const bCell = b.cells[col];
          const aVal = aCell.dataset.val !== undefined ? aCell.dataset.val : aCell.textContent;
          const bVal = bCell.dataset.val !== undefined ? bCell.dataset.val : bCell.textContent;
          const aNum = parseFloat(aVal), bNum = parseFloat(bVal);
          let cmp;
          if (!isNaN(aNum) && !isNaN(bNum)) {
            cmp = aNum - bNum;
          } else {
            cmp = aVal.localeCompare(bVal);
          }
          return sortAsc ? cmp : -cmp;
        });
        rows.forEach(r => tbody.appendChild(r));
      });
    });
    </script>
  </tal:block>
</div>
