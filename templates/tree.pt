<div metal:use-macro="layout">
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1 tal:define="
      birth_year person['birth_year'];
      death_year person['death_year'];
      is_living person['is_living'];
      died_age max(0, death_year - birth_year - 1) if (death_year and birth_year) else None;
      living_age max(0, current_year - birth_year - 1) if birth_year else None;
    ">
      <tal:block tal:condition="not surname_url">${person['full_name']}</tal:block>
      <tal:block tal:condition="surname_url">
        <span tal:condition="person['given']">${person['given']} </span><a href="${surname_url}">${person['surname']}</a>
      </tal:block>
      <span class="years" tal:condition="is_living and birth_year">(${birth_year}–)</span>
      <span class="years" tal:condition="is_living and living_age">aged ${living_age}</span>
      <span class="years" tal:condition="not is_living and (birth_year or death_year)">(${birth_year or '?'}–${death_year or ''})</span>
      <span class="ancestor-badge male" tal:condition="person['gender'] == 1">male</span>
      <span class="ancestor-badge female" tal:condition="person['gender'] == 0">female</span>
      <span class="ancestor-badge me" tal:condition="is_me">me</span>
      <span class="ancestor-badge" tal:condition="is_ancestor">ancestor</span>
      <span class="ancestor-badge living" tal:condition="is_living">living</span>
      <span class="ancestor-badge deceased" tal:condition="not is_living and died_age">died aged ${died_age}</span>
      <span class="ancestor-badge deceased" tal:condition="not is_living and not died_age">deceased</span>
    </h1>
    <p class="relation" tal:condition="relation and not is_me">your ${relation}</p>
    <nav class="person-tabs">
      <a href="../">Profile</a>
      <span class="active">Ancestors <span class="tab-count">(${num_ancestors})</span></span>
      <a href="../descendants/">Descendants <span class="tab-count">(${num_descendants})</span></a>
    </nav>
    <div class="pedigree-wrap">
      <div class="pedigree-chart" tal:attributes="style tree_grid_style">
        <a tal:repeat="node nodes"
           tal:attributes="
             href '../' if node['gen'] == 0 else '../../' + node['gramps_id'] + '/ancestors/';
             class 'pedigree-cell gen-' + str(node['gen']) + (' has-further' if node['has_further'] else '') + (' male' if node['gender'] == 1 else (' female' if node['gender'] == 0 else ''));
             style node['grid_style']
           ">
          <span class="pedigree-name">${node['full_name']}</span>
          <span class="pedigree-years" tal:condition="node['birth_year'] or node['death_year']">
            ${node['birth_year'] or '?'}–${node['death_year'] or ''}
          </span>
        </a>
      </div>
    </div>
  </div>
</div>
