<div metal:use-macro="layout">
  <tal:block metal:fill-slot="head_extra">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  </tal:block>
  <div metal:fill-slot="content" tal:omit-tag="1">
    <h1>Events <span class="years">(${format(len(events), ',')})</span></h1>
    <div id="events-map"></div>
    <input type="search" id="name-search" placeholder="Search names…">
    <div id="filters" class="event-filters"></div>
    <table class="events-table" id="events-table">
      <thead>
        <tr>
          <th data-col="0" class="sortable sort-asc">Year</th>
          <th data-col="1" class="sortable">Event</th>
          <th data-col="2" class="sortable">Person</th>
          <th data-col="3" class="sortable">Place</th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="event events"
            data-type="${event['type']}"
            tal:attributes="data-ancestor 'true' if event['is_ancestor_event'] else None;
                            data-lat event['lat'] if event['lat'] else None;
                            data-lon event['lon'] if event['lon'] else None;
                            data-url event['url_slug'] + '/' if event['lat'] else None">
          <td class="year">${event['year'] or ''}</td>
          <td>
            <a href="${event['url_slug']}/">${event['type']}</a>
            <a tal:condition="event['has_photo']" href="${event['url_slug']}/" class="photo-icon" title="Has image">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
              </svg>
            </a>
            <a tal:condition="event['grave_url']" href="${event['grave_url']}" class="photo-icon" title="Find a Grave">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14" aria-hidden="true" style="transform: rotate(180deg)">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M9.75 11.625l2.25 2.25m0 0 2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"/>
              </svg>
            </a>
          </td>
          <td>
            <span tal:condition="event['couple']">
              <span tal:condition="event['couple'][0]"
                    tal:define="person event['couple'][0]">
                <a href="${base}people/${person['gramps_id']}/"
                   tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
              </span>
              <span tal:condition="event['couple'][0] and event['couple'][1]"> &amp; </span>
              <span tal:condition="event['couple'][1]"
                    tal:define="person event['couple'][1]">
                <a href="${base}people/${person['gramps_id']}/"
                   tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
              </span>
            </span>
            <span tal:condition="not event['couple']">
              <span tal:repeat="person event['people']">
                <a href="${base}people/${person['gramps_id']}/"
                   tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
              </span>
            </span>
          </td>
          <td>
            <a tal:condition="event['place_id']"
               href="${base}places/${event['place_id']}/">${event['place']}</a>
            <span tal:condition="not event['place_id']">${event['place'] or ''}</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    const tbody = document.querySelector('#events-table tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const filtersEl = document.getElementById('filters');

    const types = [...new Set(rows.map(r => r.dataset.type))];

    let activeType = null;
    let ancestorOnly = false;
    let sortCol = 0;
    let sortAsc = true;

    function cellText(row, col) {
      return row.cells[col].textContent.trim();
    }

    function sortRows() {
      rows.sort((a, b) => {
        let av = cellText(a, sortCol);
        let bv = cellText(b, sortCol);
        if (sortCol === 0) {
          const an = parseInt(av) || 0, bn = parseInt(bv) || 0;
          return sortAsc ? an - bn : bn - an;
        }
        return sortAsc ? av.localeCompare(bv) : bv.localeCompare(av);
      });
      rows.forEach(r => tbody.appendChild(r));
    }

    document.querySelectorAll('#events-table th.sortable').forEach(th => {
      th.addEventListener('click', () => {
        const col = +th.dataset.col;
        if (sortCol === col) {
          sortAsc = !sortAsc;
        } else {
          sortCol = col;
          sortAsc = true;
        }
        document.querySelectorAll('#events-table th.sortable').forEach(h => {
          h.classList.remove('sort-asc', 'sort-desc');
        });
        th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');
        sortRows();
      });
    });

    function applyFilters() {
      const words = document.getElementById('name-search').value.toLowerCase().split(/\s+/).filter(Boolean);
      rows.forEach(r => {
        const typeMatch = activeType === null || r.dataset.type === activeType;
        const ancestorMatch = !ancestorOnly || r.dataset.ancestor === 'true';
        const name = r.cells[2].textContent.toLowerCase();
        const nameMatch = words.every(w => name.includes(w));
        r.hidden = !(typeMatch && ancestorMatch && nameMatch);
      });
      updateMap();
    }

    function makeTypeButton(label, value) {
      const btn = document.createElement('button');
      btn.textContent = label;
      btn.className = 'filter-btn';
      if (value === null) btn.classList.add('active');
      btn.addEventListener('click', () => {
        activeType = value;
        document.querySelectorAll('.filter-btn:not(.toggle-btn)').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
      });
      return btn;
    }

    const ancestorBtn = document.createElement('button');
    ancestorBtn.textContent = 'Ancestors only';
    ancestorBtn.className = 'filter-btn toggle-btn';
    ancestorBtn.addEventListener('click', () => {
      ancestorOnly = !ancestorOnly;
      ancestorBtn.classList.toggle('active', ancestorOnly);
      applyFilters();
    });

    filtersEl.appendChild(makeTypeButton('All', null));
    types.forEach(t => filtersEl.appendChild(makeTypeButton(t, t)));
    filtersEl.appendChild(document.createElement('span'));
    filtersEl.appendChild(ancestorBtn);

    document.getElementById('name-search').addEventListener('input', applyFilters);

    const eventsMap = L.map('events-map');
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(eventsMap);
    const markersLayer = L.layerGroup().addTo(eventsMap);

    function updateMap() {
      markersLayer.clearLayers();
      const groups = {};
      rows.filter(r => !r.hidden && r.dataset.lat).forEach(r => {
        const key = r.dataset.lat + ',' + r.dataset.lon;
        if (!groups[key]) groups[key] = { lat: +r.dataset.lat, lon: +r.dataset.lon, place: r.cells[3].textContent.trim(), items: [] };
        const link = r.cells[1].querySelector('a');
        groups[key].items.push({
          label: link ? link.textContent : r.cells[1].textContent.trim(),
          person: r.cells[2].textContent.trim(),
          url: r.dataset.url,
        });
      });
      const pts = Object.values(groups);
      if (!pts.length) return;
      pts.forEach(g => {
        const lines = g.items.map(i => '<a href="' + i.url + '">' + i.label + '</a>' + (i.person ? ' — ' + i.person : '')).join('<br>');
        L.marker([g.lat, g.lon]).addTo(markersLayer).bindPopup('<strong>' + g.place + '</strong><br>' + lines);
      });
      eventsMap.fitBounds(pts.map(g => [g.lat, g.lon]), { padding: [20, 20], maxZoom: 10 });
    }

    updateMap();
    </script>
  </tal:block>
</div>
