<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${person['full_name']} — Family Tree</title>
  <link rel="stylesheet" href="../style.css">
</head>
<body>
  <header>
    <a href="../index.html">Family Tree</a>
  </header>
  <main>
    <article class="person-detail">
      <h1>
        ${person['full_name']}
        <span class="ancestor-badge me" tal:condition="is_me">me</span>
        <span class="ancestor-badge" tal:condition="is_ancestor">ancestor</span>
      </h1>
      <p class="relation" tal:condition="relation and not is_me">your ${relation}</p>

      <p class="grave-link" tal:condition="person['grave_url']">
        <a href="${person['grave_url']}">View on FindAGrave</a>
      </p>

      <section class="events" tal:condition="events">
        <h2>Life events</h2>
        <table>
          <tr tal:repeat="event events">
            <th>${event['type']}</th>
            <td>${event['date'] or ''}</td>
            <td>${event['place'] or ''}</td>
            <td tal:condition="event['description']">${event['description']}</td>
            <td tal:condition="not event['description']"></td>
            <td class="age-at-death" tal:condition="event['age']">aged ${event['age']}</td>
            <td tal:condition="not event['age']"></td>
          </tr>
        </table>
      </section>

      <section class="parents" tal:condition="father or mother">
        <h2>Parents</h2>
        <ul>
          <li tal:condition="father">
            <a href="${father['gramps_id']}.html">${father['full_name']}</a>
            <span class="years" tal:condition="father['birth_year']">(b. ${father['birth_year']})</span>
          </li>
          <li tal:condition="mother">
            <a href="${mother['gramps_id']}.html">${mother['full_name']}</a>
            <span class="years" tal:condition="mother['birth_year']">(b. ${mother['birth_year']})</span>
          </li>
        </ul>
      </section>

      <section class="siblings" tal:condition="siblings">
        <h2>Siblings</h2>
        <ul>
          <li tal:repeat="sibling siblings">
            <a href="${sibling['gramps_id']}.html">${sibling['full_name']}</a>
            <span class="years" tal:condition="sibling['birth_year']">(b. ${sibling['birth_year']})</span>
          </li>
        </ul>
      </section>

      <section class="spouses" tal:condition="spouses">
        <h2>Marriages</h2>
        <ul>
          <li tal:repeat="s spouses">
            <a tal:condition="s['person']" href="${s['person']['gramps_id']}.html">${s['person']['full_name']}</a>
            <span tal:condition="not s['person']">Unknown</span>
            <span class="years" tal:condition="s['marriage'] and s['marriage']['date']">
              m. ${s['marriage']['date']}<span tal:condition="s['marriage']['place']">, ${s['marriage']['place']}</span>
            </span>
          </li>
        </ul>
      </section>

      <section class="children" tal:condition="children">
        <h2>Children</h2>
        <ul>
          <li tal:repeat="child children">
            <a href="${child['gramps_id']}.html">${child['full_name']}</a>
            <span class="years" tal:condition="child['birth_year']">(b. ${child['birth_year']})</span>
          </li>
        </ul>
      </section>

      <section class="ancestors" tal:condition="len(generations) > 1">
        <h2>Ancestors</h2>
        <div class="tree">
          <div tal:repeat="gen_group generations[1:]" class="generation">
            <h3>
              <span tal:condition="gen_group['gen'] == 1">Parents</span>
              <span tal:condition="gen_group['gen'] == 2">Grandparents</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandparents</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandparents</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 1}th great-grandparents</span>
            </h3>
            <ul>
              <li tal:repeat="ancestor gen_group['people']">
                <a href="${ancestor['gramps_id']}.html">${ancestor['full_name']}</a>
                <span class="years" tal:condition="ancestor['birth_year'] or ancestor['death_year']">
                  (${ancestor['birth_year'] or '?'}–${ancestor['death_year'] or ''})
                </span>
              </li>
            </ul>
          </div>
        </div>
      </section>
    </article>
  </main>
</body>
</html>
