<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${person['full_name']} — Family Tree</title>
  <link rel="stylesheet" href="../../style.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
</head>
<body>
  <header>
    <nav>
      <a href="../../index.html">Home</a>
      <a class="secondary" href="../../people/${me_id}/">Me</a>
      <a class="secondary" href="../../people/">People</a>
      <a class="secondary" href="../../places/">Places</a>
    </nav>
  </header>
  <main>
    <article class="person-detail">
      <h1>
        ${person['full_name']}
        <span class="ancestor-badge me" tal:condition="is_me">me</span>
        <span class="ancestor-badge" tal:condition="is_ancestor">ancestor</span>
      </h1>
      <p class="relation" tal:condition="relation and not is_me">your ${relation}</p>

      <div class="photos" tal:condition="photos">
        <img tal:repeat="photo photos"
             src="${photo['url']}"
             alt="${photo['description']}"
             class="person-photo">
      </div>

      <p class="grave-link" tal:condition="person['grave_url']">
        <a href="${person['grave_url']}">View on FindAGrave</a>
      </p>

      <div id="map" tal:condition="event_map_json != '[]'"></div>

      <section class="events" tal:condition="events">
        <h2>Life events</h2>
        <table>
          <tr tal:repeat="event events">
            <th>${event['type']}</th>
            <td>${event['date'] or ''}</td>
            <td>
              <a tal:condition="event['place_id']"
                 href="${place_url.get(event['place_id'], '')}">${event['place']}</a>
              <span tal:condition="not event['place_id']">${event['place'] or ''}</span>
            </td>
            <td tal:condition="event['description']">${event['description']}</td>
            <td tal:condition="not event['description']"></td>
            <td class="age-at-death" tal:condition="event['age']">aged ${event['age']}</td>
            <td tal:condition="not event['age']"></td>
          </tr>
        </table>
      </section>

      <section class="parents" tal:condition="father or mother">
        <h2>Parents</h2>
        <ul>
          <li tal:condition="father">
            <a href="../${father['gramps_id']}/">${father['full_name']}</a>
            <span class="years" tal:condition="father['birth_year']">(b. ${father['birth_year']})</span>
          </li>
          <li tal:condition="mother">
            <a href="../${mother['gramps_id']}/">${mother['full_name']}</a>
            <span class="years" tal:condition="mother['birth_year']">(b. ${mother['birth_year']})</span>
          </li>
        </ul>
      </section>

      <section class="siblings" tal:condition="siblings">
        <h2>Siblings</h2>
        <ul>
          <li tal:repeat="sibling siblings">
            <a href="../${sibling['gramps_id']}/">${sibling['full_name']}</a>
            <span class="years" tal:condition="sibling['birth_year']">(b. ${sibling['birth_year']})</span>
          </li>
        </ul>
      </section>

      <section class="spouses" tal:condition="spouses">
        <h2>Marriages</h2>
        <ul>
          <li tal:repeat="s spouses">
            <a tal:condition="s['person']" href="../${s['person']['gramps_id']}/">${s['person']['full_name']}</a>
            <span tal:condition="not s['person']">Unknown</span>
            <span class="years" tal:condition="s['marriage'] and s['marriage']['date']">
              m. ${s['marriage']['date']}<span tal:condition="s['marriage']['place']">, ${s['marriage']['place']}</span>
            </span>
          </li>
        </ul>
      </section>

      <section class="children" tal:condition="children">
        <h2>Children</h2>
        <ul>
          <li tal:repeat="child children">
            <a href="../${child['gramps_id']}/">${child['full_name']}</a>
            <span class="years" tal:condition="child['birth_year']">(b. ${child['birth_year']})</span>
          </li>
        </ul>
      </section>

      <section class="ancestors" tal:condition="len(generations) > 1">
        <h2>Ancestors (${sum(len(g['people']) for g in generations[1:])})</h2>
        <div class="tree">
          <div tal:repeat="gen_group generations[1:]" class="generation">
            <h3>
              <span tal:condition="gen_group['gen'] == 1">Parents</span>
              <span tal:condition="gen_group['gen'] == 2">Grandparents</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandparents</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandparents</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 1}th great-grandparents</span>
              <span class="years">(${len(gen_group['people'])} / ${2 ** gen_group['gen']})</span>
            </h3>
            <ul>
              <li tal:repeat="couple gen_group['couples']">
                <tal:block tal:repeat="person couple">
                  <a href="../${person['gramps_id']}/">${person['full_name']}</a>
                  <span class="years" tal:condition="person['birth_year'] or person['death_year']">
                    (${person['birth_year'] or '?'}–${person['death_year'] or ''})
                  </span>
                  <tal:block tal:condition="not repeat.person.end"> &amp; </tal:block>
                </tal:block>
              </li>
            </ul>
          </div>
        </div>
      </section>
    </article>
  </main>
  <script tal:condition="event_map_json != '[]'"
          src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script tal:condition="event_map_json != '[]'">
    var points = ${structure: event_map_json};
    var map = L.map('map');
    var bounds = points.map(p => [p.lat, p.lon]);
    map.fitBounds(bounds, {padding: [20, 20], maxZoom: 10});
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
    points.forEach(function(p) {
      L.marker([p.lat, p.lon]).addTo(map)
        .bindPopup('<a href="' + p.url + '">' + p.name + '</a><br>' + p.types.join(', '));
    });
  </script>
</body>
</html>
