<div metal:use-macro="layout">
  <tal:block metal:fill-slot="head_extra">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  </tal:block>
  <div metal:fill-slot="content" tal:omit-tag="1">
    <article class="person-detail">
      <tal:block metal:use-macro="person_header"></tal:block>
      <nav class="person-tabs">
        <span class="active">Profile</span>
        <a href="${base}people/${person['gramps_id']}/ancestors/">Ancestors <span class="tab-count">(${format(num_ancestors, ',')})</span></a>
        <a href="${base}people/${person['gramps_id']}/descendants/">Descendants <span class="tab-count">(${format(num_descendants, ',')})</span></a>
        <a tal:condition="num_pictures" href="${base}people/${person['gramps_id']}/pictures/">Pictures <span class="tab-count">(${format(num_pictures, ',')})</span></a>
      </nav>

      <div class="profile-overview">
        <div tal:condition="father or mother or siblings or spouses or children">
          <section class="parents" tal:condition="father or mother">
            <h3>Parents</h3>
            <ul>
              <li tal:condition="father">
                <a class="male" href="${base}people/${father['gramps_id']}/">${father['full_name']}</a>
                <span class="years" tal:condition="father['birth_year'] or father['death_year']">(${father['birth_year'] or '?'}–${father['death_year'] or ''})</span>
                <span class="ancestor-badge me" tal:condition="father['is_me']">me</span>
                <span class="ancestor-badge" tal:condition="father['is_ancestor']">ancestor</span>
              </li>
              <li tal:condition="mother">
                <a class="female" href="${base}people/${mother['gramps_id']}/">${mother['full_name']}</a>
                <span class="years" tal:condition="mother['birth_year'] or mother['death_year']">(${mother['birth_year'] or '?'}–${mother['death_year'] or ''})</span>
                <span class="ancestor-badge me" tal:condition="mother['is_me']">me</span>
                <span class="ancestor-badge" tal:condition="mother['is_ancestor']">ancestor</span>
              </li>
            </ul>
          </section>

          <section class="siblings" tal:condition="siblings">
            <h3>Siblings (${format(len(siblings), ',')})</h3>
            <ul>
              <li tal:repeat="sibling siblings">
                <tal:block tal:define="rel ('half-' if sibling['half_sibling'] else '') + ('brother' if sibling['gender'] == 1 else ('sister' if sibling['gender'] == 0 else 'sibling'))">
                  <a href="${base}people/${sibling['gramps_id']}/"
                     tal:attributes="class 'male' if sibling['gender'] == 1 else ('female' if sibling['gender'] == 0 else None)">${sibling['full_name']}</a>
                  <span class="years" tal:condition="sibling['birth_year'] or sibling['death_year']">(${sibling['birth_year'] or '?'}–${sibling['death_year'] or ''})</span>
                  <span class="years">${rel}</span>
                  <span class="ancestor-badge me" tal:condition="sibling['is_me']">me</span>
                  <span class="ancestor-badge" tal:condition="sibling['is_ancestor']">ancestor</span>
                </tal:block>
              </li>
            </ul>
          </section>

          <section class="spouses" tal:condition="any(s['person'] for s in spouses)">
            <h3>Relationships</h3>
            <ul>
              <tal:block tal:repeat="s spouses">
                <li tal:condition="s['person']">
                  <a href="${base}people/${s['person']['gramps_id']}/"
                     tal:attributes="class 'male' if s['person']['gender'] == 1 else ('female' if s['person']['gender'] == 0 else None)">${s['person']['full_name']}</a>
                  <span class="ancestor-badge me" tal:condition="s['person']['is_me']">me</span>
                  <span class="ancestor-badge" tal:condition="s['person']['is_ancestor']">ancestor</span>
                  <span class="years" tal:condition="s['rel_type'] != 'Unknown'">${s['rel_type']}</span>
                  <span class="years" tal:condition="s['marriage'] and s['marriage']['date']">
                    ${s['marriage']['date']}<span tal:condition="s['marriage']['place']">, ${s['marriage']['place']}</span>
                  </span>
                </li>
              </tal:block>
            </ul>
          </section>

          <section class="children" tal:condition="children">
            <h3>Children (${format(len(children), ',')})</h3>
            <ul>
              <li tal:repeat="child children">
                <a href="${base}people/${child['gramps_id']}/"
                   tal:attributes="class 'male' if child['gender'] == 1 else ('female' if child['gender'] == 0 else None)">${child['full_name']}</a>
                <span class="years" tal:condition="child['birth_year'] or child['death_year']">(${child['birth_year'] or '?'}–${child['death_year'] or ''})</span>
                <span class="ancestor-badge me" tal:condition="child['is_me']">me</span>
                <span class="ancestor-badge" tal:condition="child['is_ancestor']">ancestor</span>
              </li>
            </ul>
          </section>
        </div>

        <div>
          <div class="external-links" tal:condition="person['external_links']">
            <h3>External links</h3>
            <ul>
              <li tal:repeat="link person['external_links']">
                <a href="${link['url']}">${link['label']}</a>
              </li>
            </ul>
          </div>

          <div class="profile-media" tal:condition="occupations">
            <div class="occupations">
              <h3>Occupations</h3>
              <ul>
                <li tal:repeat="occ occupations">
                  ${occ['label']}
                  <span class="years" tal:condition="occ['year']">(${occ['year']})</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <section class="events" tal:condition="events">
        <h2>Life Events</h2>
        <tal:block tal:define="event_types sorted(set(e['type'] for e in events))">
          <div class="event-filters" tal:condition="len(event_types) > 1">
            <button class="filter-btn active" data-filter="all" onclick="filterEvents(this)">All</button>
            <button tal:repeat="et event_types" class="filter-btn"
                    tal:attributes="data-filter et"
                    onclick="filterEvents(this)">${et}</button>
          </div>
        </tal:block>
        <table>
          <thead>
            <tr><th>Date</th><th>Age</th><th>Event</th><th>Detail</th><th>Location</th></tr>
          </thead>
          <tbody>
            <tr tal:repeat="event events" tal:attributes="data-type event['type']">
              <tal:block tal:define="
                  year event['year'];
                  full_date event['date']
                ">
                <td>${full_date or year or ''}</td>
                <td class="event-age" tal:define="has_age event['age'] is not None and event['age'] > 0">
                  <tal:block tal:condition="has_age">${event['age']}</tal:block>
                </td>
                <td>
                  <a href="${base}events/${event['url_slug']}/">${event['type']}</a>
                  <a tal:condition="event['has_photo']" href="${base}events/${event['url_slug']}/" class="photo-icon" title="Has image">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
                    </svg>
                  </a>
                </td>
                <td>
                  <tal:block tal:condition="event['type'] == 'Birth'">
                    <tal:block tal:condition="father or mother">
                      <a tal:condition="father"
                         href="${base}people/${father['gramps_id']}/"
                         tal:attributes="class 'male' if father['gender'] == 1 else ('female' if father['gender'] == 0 else None)">${father['full_name']}</a>
                      <span tal:condition="father and mother"> and </span>
                      <a tal:condition="mother"
                         href="${base}people/${mother['gramps_id']}/"
                         tal:attributes="class 'male' if mother['gender'] == 1 else ('female' if mother['gender'] == 0 else None)">${mother['full_name']}</a>
                    </tal:block>
                  </tal:block>
                  <tal:block tal:condition="event['type'] != 'Birth'">
                    <a tal:condition="event['description_url']"
                       href="${event['description_url']}"
                       tal:attributes="class 'male' if event['description_gender'] == 1 else ('female' if event['description_gender'] == 0 else None)">${event['description']}</a>
                    <span tal:condition="not event['description_url']">${event['description'] or ''}</span>
                  </tal:block>
                </td>
                <td>
                  <a tal:condition="event['place_id']"
                     href="${place_url.get(event['place_id'], '')}">${event['place']}</a>
                  <span tal:condition="not event['place_id']">${event['place'] or ''}</span>
                </td>
              </tal:block>
            </tr>
          </tbody>
        </table>
      </section>

      <div id="map" tal:condition="event_map_json != '[]'"></div>

      <section class="ancestors" tal:condition="len(generations) > 1">
        <h2>Ancestors (${format(sum(len(g['people']) for g in generations[1:]), ',')})</h2>
        <div class="tree">
          <div tal:repeat="gen_group generations[1:]" class="generation">
            <h3>
              <span tal:condition="gen_group['gen'] == 1">Parents</span>
              <span tal:condition="gen_group['gen'] == 2">Grandparents</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandparents</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandparents</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 2}th great-grandparents</span>
              <span class="years">(${format(len(gen_group['people']), ',')} / ${format(2 ** gen_group['gen'], ',')})</span>
              <span tal:define="pct len(gen_group['people']) * 100 // (2 ** gen_group['gen'])"
                    tal:attributes="class ('years ' + ('pct-high' if pct >= 75 else ('pct-mid' if pct >= 50 else 'pct-low')))">
                ${pct}%
              </span>
            </h3>
            <div class="two-col">
              <tal:block tal:repeat="couple gen_group['couples']">
                <div>
                  <tal:block tal:define="person couple[0]">
                    <a href="${base}people/${person['gramps_id']}/"
                       tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
                    <span class="years" tal:condition="person['birth_year'] or person['death_year']">
                      (${person['birth_year'] or '?'}–${person['death_year'] or ''})
                    </span>
                  </tal:block>
                </div>
                <div>
                  <tal:block tal:condition="len(couple) > 1">
                    <tal:block tal:define="person couple[1]">
                      <a href="${base}people/${person['gramps_id']}/"
                         tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
                      <span class="years" tal:condition="person['birth_year'] or person['death_year']">
                        (${person['birth_year'] or '?'}–${person['death_year'] or ''})
                      </span>
                    </tal:block>
                  </tal:block>
                </div>
              </tal:block>
            </div>
          </div>
        </div>
      </section>

      <section class="descendants" tal:condition="descendant_generations">
        <h2>Descendants (${format(sum(len(g['people']) for g in descendant_generations), ',')})</h2>
        <div class="tree">
          <div tal:repeat="gen_group descendant_generations" class="generation">
            <h3>
              <span tal:condition="gen_group['gen'] == 1">Children</span>
              <span tal:condition="gen_group['gen'] == 2">Grandchildren</span>
              <span tal:condition="gen_group['gen'] == 3">Great-grandchildren</span>
              <span tal:condition="gen_group['gen'] == 4">2nd great-grandchildren</span>
              <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 2}th great-grandchildren</span>
              <span class="years">(${format(len(gen_group['people']), ',')})</span>
            </h3>
            <ul>
              <li tal:repeat="person gen_group['people']">
                <a href="${base}people/${person['gramps_id']}/"
                   tal:attributes="class 'male' if person['gender'] == 1 else ('female' if person['gender'] == 0 else None)">${person['full_name']}</a>
                <span class="years" tal:condition="person['birth_year'] or person['death_year']">
                  (${person['birth_year'] or '?'}–${person['death_year'] or ''})
                </span>
                <span class="ancestor-badge me" tal:condition="person['is_me']">me</span>
                <span class="ancestor-badge" tal:condition="person['is_ancestor']">ancestor</span>
              </li>
            </ul>
          </div>
        </div>
      </section>
    </article>
  </div>
  <tal:block metal:fill-slot="scripts">
    <script>
    function filterEvents(btn) {
      document.querySelectorAll('.event-filters .filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      var filter = btn.dataset.filter;
      document.querySelectorAll('.events tbody tr').forEach(function(row) {
        if (row.classList.contains('row-detail')) return;
        var show = filter === 'all' || row.dataset.type === filter;
        row.style.display = show ? '' : 'none';
        var next = row.nextElementSibling;
        if (next && next.classList.contains('row-detail')) {
          next.style.display = (show && next.classList.contains('open')) ? '' : 'none';
        }
      });
    }
    </script>
    <script tal:condition="event_map_json != '[]'"
            src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script tal:condition="event_map_json != '[]'">
    var points = ${structure: event_map_json};
    var map = L.map('map');
    var bounds = points.map(p => [p.lat, p.lon]);
    map.fitBounds(bounds, {padding: [20, 20], maxZoom: 10});
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
    points.forEach(function(p) {
      L.marker([p.lat, p.lon]).addTo(map)
        .bindPopup('<a href="' + p.url + '">' + p.name + '</a><br>' + p.types.join(', '));
    });
    </script>
  </tal:block>
</div>
