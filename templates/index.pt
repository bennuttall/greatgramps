<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Family Tree</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <h1>Family Tree</h1>
  </header>
  <main>
    <div class="tree">
      <div tal:repeat="gen_group generations" class="generation">
        <h2>
          <span tal:condition="gen_group['gen'] == 0">You</span>
          <span tal:condition="gen_group['gen'] == 1">Parents</span>
          <span tal:condition="gen_group['gen'] == 2">Grandparents</span>
          <span tal:condition="gen_group['gen'] == 3">Great-grandparents</span>
          <span tal:condition="gen_group['gen'] == 4">2nd great-grandparents</span>
          <span tal:condition="gen_group['gen'] &gt; 4">${gen_group['gen'] - 1}th great-grandparents</span>
        </h2>
        <ul>
          <li tal:repeat="person gen_group['people']">
            <a href="people/${person['gramps_id']}.html">${person['full_name']}</a>
            <span class="years" tal:condition="person['birth_year'] or person['death_year']">
              (${person['birth_year'] or '?'}–${person['death_year'] or ''})
            </span>
          </li>
        </ul>
      </div>
    </div>
  </main>
</body>
</html>
